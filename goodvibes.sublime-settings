{
    // The base URL of your OpenAI-compatible API (e.g. https://openrouter.ai/api/v1/chat/completions)
    "api_endpoint": "",
    // Your API key for the chosen provider (e.g. sk-...)
    "api_key": "",
    // Optional: Name of environment variable containing the API key (e.g. "MISTRAL_API_KEY").
    // If both api_key and api_key_var are set, api_key takes precedence.
    // Requires at least one of api_key or api_key_var to be configured.
    "api_key_var": "",
    // The specific model you want to use (e.g. "minimax/minimax-m2.5")
    "model_id": "",
    // Optional: Extra JSON parameters to inject into the API request payload.
    // By default, this disables thinking/reasoning to ensure low Time To First Token latency.
    // Note: The keys "model", "messages", and "stream" are reserved and will be ignored if set here.
    "api_parameters": {
        "reasoning_effort": "none"
    },
    // Optional: The prompt that instructs the model on how to behave.
    // The "%language%" variable is automatically replaced with the file's current syntax (e.g. "Python").
    "system_prompt": "You are a helpful coding assistant. The user is currently editing a %language% file. Replace the user's input with the requested output. NEVER include markdown formatting (like ```) around your code unless the user explicitly asks for markdown output. Provide ONLY the replacement text without conversational filler. If the user asks for a simple refactor, return ONLY the refactored code."
}
